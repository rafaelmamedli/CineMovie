<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================================================================
         CineMovie is skinnable: every screen paints itself from theme
         attributes (?attr/colorSurface, ?attr/colorPrimary, ...), never from
         a raw colour. A new movie skin = one palette below + one style in
         themes.xml + one entry in CineTheme.kt.
         ================================================================== -->

    <!-- ===== Skin: Matrix ("follow the white rabbit") ===== -->
    <color name="matrix_background">#04060A</color>
    <color name="matrix_surface">#0B1310</color>
    <color name="matrix_surface_variant">#12211A</color>
    <color name="matrix_outline">#1E3A28</color>
    <color name="matrix_accent">#22FF6A</color>
    <color name="matrix_on_accent">#00230C</color>
    <color name="matrix_text_primary">#E4FFEC</color>
    <color name="matrix_text_secondary">#7FB794</color>

    <!-- ===== Skin: Dune ("fear is the mind-killer") ===== -->
    <color name="dune_background">#100A06</color>
    <color name="dune_surface">#1C130D</color>
    <color name="dune_surface_variant">#2A1D14</color>
    <color name="dune_outline">#43301F</color>
    <color name="dune_accent">#E9A63C</color>
    <color name="dune_on_accent">#2A1704</color>
    <color name="dune_text_primary">#F8EEDF</color>
    <color name="dune_text_secondary">#BC9F80</color>

    <!-- ===== Skin independent ===== -->
    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
    <color name="scrim_strong">#CC000000</color>
    <color name="scrim_medium">#99000000</color>

    <!-- Legacy names still referenced by a few drawables -->
