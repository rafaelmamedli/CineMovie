<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      CineMovie is a dark themed app: all layouts are drawn on a dark surface with
      light text, so the theme is pinned to the dark Material 3 variant instead of
      following the system light/dark setting (light mode used to render black text
      on the dark background).
    -->
    <style name="Base.Theme.MovieApp" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black_10</item>
        <item name="colorSurface">@color/black_10</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">@color/black_10</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <!-- Ignored from Android 15 on (edge to edge), kept for older versions. -->
        <item name="android:statusBarColor">@color/black_10</item>
        <item name="android:navigationBarColor">@color/black_10</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MovieApp" parent="Base.Theme.MovieApp" />
</resources>
