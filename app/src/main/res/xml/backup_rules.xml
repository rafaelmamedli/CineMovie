<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 (API 30) and below.
   Only the local favourites database is backed up; the app stores nothing else.
-->
<full-backup-content>
    <include domain="database" path="fav_movie_database" />
    <include domain="database" path="fav_movie_database-wal" />
    <include domain="database" path="fav_movie_database-shm" />
</full-backup-content>
