<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-to-device transfer rules for Android 12 (API 31) and above.
   Only the local favourites database is transferred; no credentials are stored.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fav_movie_database" />
        <include domain="database" path="fav_movie_database-wal" />
        <include domain="database" path="fav_movie_database-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fav_movie_database" />
        <include domain="database" path="fav_movie_database-wal" />
        <include domain="database" path="fav_movie_database-shm" />
    </device-transfer>
</data-extraction-rules>
