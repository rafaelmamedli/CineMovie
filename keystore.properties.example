# Copy this file to keystore.properties (git-ignored) to sign release builds locally.
# Create the keystore once and NEVER lose it - Play Store uploads must keep the same key:
#   keytool -genkey -v -keystore cinemovie-upload.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias cinemovie
storeFile=../cinemovie-upload.jks
storePassword=
keyAlias=cinemovie
keyPassword=
